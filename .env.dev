# Development Environment Variables
# Copy this file to .env and update values as needed

# Database - Use SQLite for quick development (no PostgreSQL needed)
USE_SQLITE=true
# Or use PostgreSQL if preferred:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/resort_db

# Security (change in production)
SECRET_KEY=your-dev-secret-key-minimum-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS - Allow all localhost ports for development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,http://127.0.0.1:5173

# Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG
DEBUG=true

# Frontend
VITE_API_URL=http://localhost:8000

# Payment Gateways (test keys only for development)
PAYMOB_API_KEY=test_paymob_api_key
PAYMOB_INTEGRATION_ID=test_integration_id
PAYMOB_HMAC_SECRET=test_hmac_secret

STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_test_secret

# Redis (optional for development)
REDIS_URL=redis://localhost:6379/0

# Webhooks (optional)
N8N_WEBHOOK_URL=
