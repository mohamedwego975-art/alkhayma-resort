# Development Environment Variables
# Copy this file to .env and update values as needed

# Database - PostgreSQL (Development)
DB_USER=resort_user
DB_PASS=strong_password_123!
DB_NAME=resort_db
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://resort_user:strong_password_123!@localhost:5432/resort_db

# Security (change in production)
SECRET_KEY=dev-secret-key-change-in-production-64-chars-long-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG
DEBUG=true
USE_SQLITE=false

# Frontend
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# CORS - Allow all localhost ports for development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Payment Gateways (test keys only for development)
PAYMOB_API_KEY=dev-key
STRIPE_SECRET_KEY=sk_test_dev
STRIPE_WEBHOOK_SECRET=whsec_dev
PAYMOB_API_KEY=test_paymob_api_key
PAYMOB_INTEGRATION_ID=test_integration_id
PAYMOB_HMAC_SECRET=test_hmac_secret

STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_test_secret

# Redis (optional for development)
REDIS_URL=redis://localhost:6379/0

# Webhooks (optional)
N8N_WEBHOOK_URL=
