# Production Environment Variables
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/resort_db
REDIS_URL=redis://localhost:6379
ENVIRONMENT=production

# JWT Settings
SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY_FOR_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=["https://alkhaima-resort.com","https://www.alkhaima-resort.com"]

# Payment Gateways
PAYMOB_API_KEY=CHANGE_ME_PAYMOB_API_KEY
PAYMOB_INTEGRATION_ID=CHANGE_ME_PAYMOB_INTEGRATION_ID
PAYMOB_HMAC_SECRET=CHANGE_ME_PAYMOB_HMAC_SECRET

STRIPE_SECRET_KEY=sk_live_CHANGE_ME_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_STRIPE_WEBHOOK_SECRET

# OpenAI
OPENAI_API_KEY=sk-CHANGE_ME_OPENAI_API_KEY

# N8N Webhooks
N8N_WEBHOOK_URL=https://n8n.alkhaima-resort.com/webhook

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@alkhaima-resort.com
SMTP_PASSWORD=CHANGE_ME_EMAIL_PASSWORD

# Monitoring
SENTRY_DSN=CHANGE_ME_SENTRY_DSN
