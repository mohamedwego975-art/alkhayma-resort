node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist
dist-ssr
*.local

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing
coverage
*.lcov

# Logs
logs
*.log

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Documentation
README.md
*.md

# Cache
.cache
.temp
.tmp

# Misc
*.tar.gz
*.zip
