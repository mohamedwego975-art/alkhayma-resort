# Resort Platform - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# Database Configuration
# =============================================================================
DB_USER=postgres
DB_PASS=changeme123
DB_NAME=resort_db
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Environment Settings
# =============================================================================
ENVIRONMENT=development
DEBUG=true

# =============================================================================
# Security Configuration
# =============================================================================
# Generate a 64-character random string for SECRET_KEY
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-64-char-secret-key-here-change-in-production-minimum-64-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# JWT Settings
JWT_SECRET_KEY=${SECRET_KEY}
JWT_ALGORITHM=${ALGORITHM}
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=${ACCESS_TOKEN_EXPIRE_MINUTES}

# =============================================================================
# AI Service Configuration
# =============================================================================
OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# Payment Gateway Configuration
# =============================================================================
PAYMOB_API_KEY=your-paymob-api-key-here
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here

# =============================================================================
# Email Configuration (Gmail/SMTP)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# =============================================================================
# WhatsApp Configuration (Twilio)
# =============================================================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# =============================================================================
# N8N Automation Configuration
# =============================================================================
N8N_USER=admin
N8N_PASS=changeme123
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=${N8N_USER}
N8N_BASIC_AUTH_PASSWORD=${N8N_PASS}
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/webhook/

# =============================================================================
# File Upload Configuration
# =============================================================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# Monitoring Configuration (Prometheus + Grafana)
# =============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_PASS=changeme123
GRAFANA_ADMIN_PASSWORD=${GRAFANA_PASS}

# =============================================================================
# Frontend Configuration
# =============================================================================
VITE_API_URL=http://localhost:8000
VITE_AI_SERVICE_URL=http://localhost:8001
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# =============================================================================
# Backend Host (for webhooks)
# =============================================================================
BACKEND_HOST=http://localhost:8000

# =============================================================================
# Trial Mode Settings
# =============================================================================
TRIAL_MODE=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_WHATSAPP_NOTIFICATIONS=true
ENABLE_N8N_AUTOMATION=true
ENABLE_MONITORING=true
